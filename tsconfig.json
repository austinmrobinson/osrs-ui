{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "paths": {
      "@/lib/*": ["./registry/osrs/lib/*"],
      "@/*": ["./*"]
    }
  },
  "include": ["registry", "scripts", "islands", "site", "examples", "sprites.config.ts", "blume.config.ts"]
}
