{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "paths": {
      "@/lib/*": [
        "./registry/osrs/lib/*"
      ],
      "@/components/ui/*": [
        "./registry/osrs/ui/*"
      ],
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "registry",
    "scripts",
    "islands",
    "site",
    "examples",
    "gallery",
    "sprites.config.ts",
    "blume.config.ts"
  ]
}