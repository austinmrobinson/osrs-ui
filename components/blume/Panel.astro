---
const { title } = Astro.props;
---

<aside
  class="not-prose osrs-card osrs-card-offer osrs-framed osrs-frame-ge-offer osrs-text my-6"
  data-blume-narration="skip"
  data-blume-panel
  data-blume-right-rail-item
>
  {
    title && (
      <p class="osrs-card-header m-0!">
        {title}
      </p>
    )
  }
  <div class="px-2 py-2 [&>:first-child]:mt-0! [&>:last-child]:mb-0!">
    <slot />
  </div>
</aside>
