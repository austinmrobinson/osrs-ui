---
import data from "blume:data";

import AccordionItem from "blume/components/content/AccordionItem.astro";
import { contentStrings } from "blume/components/content/content-strings.ts";

const { content: strings } = contentStrings(data, Astro.currentLocale);
const { defaultOpen = false, title = strings.showMore } = Astro.props;
---

<div class="not-prose osrs-site-accordion osrs-framed osrs-frame-tan-border osrs-text my-4">
  <AccordionItem defaultOpen={defaultOpen} title={title}>
    <slot />
  </AccordionItem>
</div>
