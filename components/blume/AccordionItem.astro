---
import { PlusIconGlyph as PlusGlyph, MinusIconGlyph as MinusGlyph } from "@/registry/osrs/ui/icon-sprites";
import Icon from "blume/components/Icon.astro";
import { componentSlug } from "blume/components/slug.ts";
import { renderInlineTitle } from "blume/components/content/inline-markdown.ts";

interface Props {
  title: string;
  description?: string;
  defaultOpen?: boolean;
  id?: string;
  icon?: string;
}

const { defaultOpen = false, description, icon, id, title } = Astro.props;
// The id still slugs the title as written, so existing deep links keep
// working once its Markdown renders.
const accordionId = id ?? componentSlug(title);
// The title's inline Markdown (`The \`x\` option`), or undefined for a title
// shown as written.
const titleHtml = await renderInlineTitle(title);
---

<details
  class="not-prose"
  data-blume-accordion
  id={accordionId}
  open={defaultOpen}
>
  <summary
    class="osrs-site-accordion-summary flex cursor-pointer list-none items-center justify-between [&::-webkit-details-marker]:hidden"
  >
    <span class="flex items-start gap-2">
      {
        icon && (
          <Icon
            class="mt-0.5 shrink-0 text-muted-foreground"
            name={icon}
            size={16}
          />
        )
      }
      <span>
        {
          titleHtml === undefined ? (
            <span class="block">{title}</span>
          ) : (
            <span
              class="block [&_a]:underline [&_a]:decoration-current/50 [&_code]:font-mono"
              set:html={titleHtml}
            />
          )
        }
        {
          description && (
            <span class="osrs-setting-desc block">
              {description}
            </span>
          )
        }
      </span>
    </span>
    <span class="osrs-site-accordion-icon" aria-hidden="true">
      <PlusGlyph className="osrs-site-accordion-plus" />
      <MinusGlyph className="osrs-site-accordion-minus" />
    </span>
  </summary>
  <div class="osrs-site-accordion-body [&>:first-child]:mt-0! [&>:last-child]:mb-0!">
    <slot />
  </div>
</details>

<script>
  const state = window as Window & { __blumeAccordionHash?: boolean };
  if (!state.__blumeAccordionHash) {
    state.__blumeAccordionHash = true;

    // Repeated titles slug to the same id (e.g. several <Expandable> blocks all
    // defaulting to "show-more"); suffix the later ones so ids stay unique. The
    // first keeps the plain slug, so hash deep-links stay stable.
    const dedupeAccordionIds = () => {
      const seen = new Map<string, number>();
      for (const accordion of document.querySelectorAll<HTMLElement>(
        "[data-blume-accordion][id]"
      )) {
        const count = seen.get(accordion.id) ?? 0;
        seen.set(accordion.id, count + 1);
        if (count > 0) {
          accordion.id = `${accordion.id}-${count + 1}`;
        }
      }
    };

    const accordionFromHash = () => {
      const id = decodeURIComponent(window.location.hash.slice(1));
      if (!id) {
        return null;
      }
      return document.getElementById(id)?.matches("[data-blume-accordion]")
        ? (document.getElementById(id) as HTMLDetailsElement)
        : null;
    };

    const openHashAccordion = () => {
      const accordion = accordionFromHash();
      if (!accordion) {
        return;
      }
      accordion.open = true;
      requestAnimationFrame(() => {
        accordion.scrollIntoView({ block: "start" });
      });
    };

    // Only the reader opening an item points the hash at it, so this keys on
    // the summary's click (pointer, Enter, or Space) rather than `toggle`: a
    // `defaultOpen` item a client-router swap inserts fires `toggle` too, and
    // that must not overwrite the hash the reader arrived with.
    document.addEventListener("click", (event) => {
      const summary =
        event.target instanceof Element ? event.target.closest("summary") : null;
      const accordion = summary?.parentElement;
      if (
        event.defaultPrevented ||
        !(accordion instanceof HTMLDetailsElement) ||
        !accordion.matches("[data-blume-accordion]") ||
        // Open now means this click closes it.
        accordion.open ||
        !accordion.id
      ) {
        return;
      }

      // Keep the entry's state: the client router ignores a popstate whose
      // state is null, so Back to this page would change only the URL.
      history.replaceState(
        history.state,
        "",
        `#${encodeURIComponent(accordion.id)}`
      );
    });

    const init = () => {
      dedupeAccordionIds();
      openHashAccordion();
    };

    window.addEventListener("hashchange", openHashAccordion);
    // Client-router swaps replace the body with fresh server-rendered
    // accordions (duplicate ids and all), so the dedupe + hash-open pass has
    // to run again for each new page.
    document.addEventListener("astro:after-swap", init);
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", init, { once: true });
    } else {
      init();
    }
  }
</script>
